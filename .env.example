# 하하호호 스튜디오 설정 견본
# 이 파일을 복사해 이름을 .env 로 바꾼 뒤, 필요한 칸만 채우세요.
# .env 는 git에 올라가지 않습니다. 실제 키·비밀번호는 여기(.env.example)에 절대 쓰지 마세요.

# OpenAI 이미지 생성 키 (sk- 로 시작). 비워 두고 운영자 모드 > AI 설정에서 저장해도 됩니다.
OPENAI_API_KEY=

# 관리자 로그인 (앱 첫 화면). 둘 다 채워야 로그인할 수 있어요. 값은 .env 에만 쓰세요.
ADMIN_ID=
ADMIN_PASSWORD=

# --- 아래는 보통 그대로 둡니다. 바꿀 때만 맨 앞 # 을 지우세요 ---

# 행사 설정 파일 이름 (config/events/<이름>.json). 기본: 2026-viking-beerbomb
# EVENT_ID=

# 레퍼런스(테마) 사진 폴더. 기본: G:\내 드라이브\하하호호스튜디오\App 개발\콘셉트 이미지\레퍼런스 이미지\테마 이미지
# REFERENCE_ROOT=

# 손님 사진·설정을 저장할 폴더. 기본: 앱 폴더의 data
# DATA_DIR=

# 결과 사진(인화용 최종본) 팀 공용 폴더. 기본: C:\하하호호스튜디오 (없으면 자동 생성)
# 운영자 화면 > AI 설정에서 한 번 저장하면 그 값이 우선합니다.
# RESULT_DIR=...

# 서버 주소·포트. 기본: 127.0.0.1 / 3000 (이 노트북 안에서만 열림. HOST는 바꾸지 마세요)
# HOST=
# PORT=

# --- 사진 만들기 방식 (2026-10-14 v4, 대표님 지시로 10/12 방식 대체) ---
# AI에는 [1] 표본사진(레퍼런스) 원본 = 기준(배경·의상·헤어·포즈·조명·구도 전부 유지) [2] 손님 사진 = 얼굴 정체성만 을 넣고,
# 표본 속 인물의 얼굴만 손님 얼굴로 바꿉니다. 규칙: config/face-swap-rules.en.md (원문 config/face-swap-rules.md), 지시문 맨 뒤 = 최우선.
# 얼굴 위치를 찾으면 얼굴 범위 마스크를 함께 보냅니다. 표본 속 글자 바꾸기: config/text-replacements.json
# (장면 설명 config/ref-descriptions.json 은 기록용 보조 정보. 아래 비전 모델은 지금은 쓰지 않습니다)
# VISION_MODEL=

# --- 사진 올리기 폴더 (2026-10-12) ---
# 비우면 바탕화면의 하하호호업로드 폴더를 자동으로 찾고, 없으면 새로 만듭니다. (운영자 화면 > AI 설정에서 정하면 그 값이 우선)
# UPLOAD_DIR=D:\Desktop\하하호호업로드

# --- 창 크기 (start-hahahoho.bat / start-kiosk.bat) ---
# 화면의 몇 % 크기 창으로 열지 (50~100, 기본 80). 여기 적으면 앱을 업데이트해도 유지됩니다.
# WINDOW_SCALE=80
